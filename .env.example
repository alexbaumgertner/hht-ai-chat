# --- Core ---
# Signing secret for Payload auth/session tokens. Required.
PAYLOAD_SECRET=change-me-in-production

# Database.
# Production/staging: a Neon Postgres connection string (postgres://...).
# Local dev: leave UNSET to use a zero-setup local SQLite file (see ARCHITECTURE.md §11).
# DATABASE_URI=postgres://user:password@host/db?sslmode=require

# Public URL of the app (used by Payload for links/CORS).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- AI provider (optional) ---
# If AI_API_KEY is set, the OpenAI-compatible provider is used; otherwise a local
# EchoProvider answers (so the chat works with zero configuration).
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- Dev/e2e seeding (optional) ---
# If both are set, a user with these credentials is created on first boot.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=changeme123

# --- Later phases (not used in Phase 1) ---
# BLOB_READ_WRITE_TOKEN=
# RESEND_API_KEY=
# VK_CLIENT_ID=
# VK_CLIENT_SECRET=
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
