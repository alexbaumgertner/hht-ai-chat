DATABASE_URL=postgresql://127.0.0.1:5432/hht_ai_chat
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Optional override for AI provider key (otherwise set in Payload AI Settings global)
OPENAI_API_KEY=

# Bearer token for GET /api/cron/reset-usage
CRON_SECRET=

# Auth.js (social login). Generate a secret with: npx auth secret
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Facebook Login app credentials.
# Redirect URI: {origin}/api/auth/callback/facebook
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Email (OTP login). See docs/email.md
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=HHT AI Chat
# Prefer Resend on Vercel. If set, SMTP_* is ignored.
RESEND_API_KEY=
# Fallback: any SMTP provider (SendGrid, Mailgun, Gmail app password, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
